package warshal;

import java.util.Scanner;

public class Warshalls {

	void flyd(int[][] w,int n)
	{
		int i,j,k;

		for(k=1;k<=n;k++)
			for(i=1;i<=n;i++)
				for(j=1;j<=n;j++)
					w[i][j]=(w[i][j]!=0)||((w[i][k]!=0) && (w[k][j]!=0))?1:0;
	}

	public static void main(String[] args)
	{
		int a[][]=new int[10][10];
